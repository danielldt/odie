# ======================
# Database
# ======================
DATABASE_URL=postgresql://odie:odie_secret@localhost:5432/odie_polymarket
POSTGRES_USER=odie
POSTGRES_PASSWORD=odie_secret
POSTGRES_DB=odie_polymarket

# ======================
# Redis
# ======================
REDIS_URL=redis://localhost:6379

# ======================
# JWT & Auth
# ======================
JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ======================
# Credential Encryption
# ======================
# 32-byte base64 key for AES-256-GCM
CREDENTIALS_MASTER_KEY=YOUR_BASE64_32_BYTE_KEY_HERE

# ======================
# Polymarket APIs
# ======================
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CHAIN_ID=137

# ======================
# Server
# ======================
API_PORT=3001
API_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# ======================
# Worker
# ======================
WORKER_CONCURRENCY=5
