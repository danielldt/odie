{
  "name": "@odie/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "migrate": "node --loader ts-node/esm src/migrate.ts",
    "migrate:create": "node --loader ts-node/esm src/migrate-create.ts",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@odie/shared": "workspace:*",
    "drizzle-orm": "^0.29.0",
    "pg": "^8.11.3",
    "postgres": "^3.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "drizzle-kit": "^0.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
